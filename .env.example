MODEL_MODE=demo
MODEL_PROVIDER=openai
# Live mode requires MODEL_NAME and MODEL_API_KEY; compatible also needs MODEL_BASE_URL.
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
DATABASE_PATH=data/material-agent.db
HOST=127.0.0.1
PORT=3000
# Explicit local demonstration identities. Replace tokens before sharing access.
AUTH_TOKENS={"local-user-token":{"userId":"alice","role":"USER"},"local-reviewer-token":{"userId":"reviewer","role":"REVIEWER"}}
MATERIAL_TOKEN=local-user-token
DATA_ADAPTER=local
# MCP/CLI: configure only trusted commands; no model-produced shell commands.
DATA_COMMAND=
DATA_ARGS=[]
